# ── Supabase ──────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── JWT / Sesiones ────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-segura-de-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Wompi (pagos) ─────────────────────────────────
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=your-webhook-secret
WOMPI_ENV=sandbox   # cambiar a "production" cuando sea real

# ── App ───────────────────────────────────────────
APP_NAME=Tribu
APP_ENV=development
BASE_URL=http://localhost:8000
